# Конфигурация приложения
APP_NAME=GoToDoList
APP_VERSION=1.0.0
APP_PORT=8080
APP_DEBUG=true

# Конфигурация базы данных PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=todolist
DB_SSLMODE=disable
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100
DB_CONN_MAX_LIFETIME=5
